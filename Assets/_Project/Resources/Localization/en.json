    { "key": "char.common_girl.name", "value": "Anya (Night Student)" },
    { "key": "char.common_girl.ability", "value": "Art student: drops by for a double Americano before deadlines and helps with orders." },
    { "key": "char.common_girl.quote.0", "value": "Hey! Could I get a double Americano? Tonight's gonna be long, and these sketches won't draw themselves." },
    { "key": "char.common_girl.quote.1", "value": "I love how your cafe smells of fresh roast and rain outside. Instant inspiration!" },
    { "key": "char.common_girl.quote.2", "value": "Your latte art looks like a real painting! Almost a shame to stir something this pretty." },
    { "key": "char.common_girl.quote.3", "value": "Sitting at this corner table, deadlines don't feel nearly as scary. Thanks for the cozy vibes!" },
    { "key": "char.common_girl.quote.4", "value": "You know, your cafe has become my favorite spot in town. Definitely dropping by tomorrow night too!" },

    { "key": "char.rare_girl.name", "value": "Mira (Head Barista)" },
    { "key": "char.rare_girl.ability", "value": "Seasoned barista and heart of the shift — under her watch, the cafe runs twice as fast." },
    { "key": "char.rare_girl.quote.0", "value": "Don't rush at the espresso machine. Mira will watch the milk temp, so just keep your rhythm." },
    { "key": "char.rare_girl.quote.1", "value": "Hmm, the microfoam is noticeably silkier. Quite decent for a night shift." },
    { "key": "char.rare_girl.quote.2", "value": "If you close the shift without spilling a single espresso, fine — Mira will treat you to a signature raf." },
    { "key": "char.rare_girl.quote.3", "value": "Don't let it go to your head... but working behind the same counter with you turned out surprisingly comfortable." },
    { "key": "char.rare_girl.quote.4", "value": "Looks like we've become the best night crew in the city. Keep it up!" },

    { "key": "char.legendary_girl.name", "value": "Luna (Jazz Singer)" },
    { "key": "char.legendary_girl.ability", "value": "Legend of the midnight cafe: her presence draws crowds of guests and incredible luck." },
    { "key": "char.legendary_girl.quote.0", "value": "Good evening! After a late show, nothing beats a hot cup of coffee in a quiet lounge." },
    { "key": "char.legendary_girl.quote.1", "value": "The clink of cups and hiss of steam sound just like a soft jazz rhythm. Amazing atmosphere!" },
    { "key": "char.legendary_girl.quote.2", "value": "Notice the passersby gathering outside? Your coffee draws people better than any billboard." },
    { "key": "char.legendary_girl.quote.3", "value": "You know, I love stopping by after midnight. Your smile warms better than any blanket." },
    { "key": "char.legendary_girl.quote.4", "value": "As long as warm light shines in these cafe windows, night owls will always have a place to return to!" }
  ]
