  characterId: legendary_girl_2
  characterName: "\u041A\u0438\u0440\u0430 (\u041D\u043E\u0447\u043D\u043E\u0439 \u043A\u0443\u0440\u044C\u0435\u0440)"
  portrait: {fileID: 21300000, guid: 3ad0babc8b92ad36ca048d84bc6e1780, type: 3}
  rarity: 3
  emotions:
  - emotion: 0
    sprite: {fileID: 21300000, guid: 374342b964951092aa5a253a57842942, type: 3}
  - emotion: 1
    sprite: {fileID: 21300000, guid: 8376fae92c6d74db5bd480b810d6f6d3, type: 3}
  - emotion: 2
    sprite: {fileID: 21300000, guid: 33b5c18d4377e6b598ef0c2957e8184d, type: 3}
  - emotion: 3
    sprite: {fileID: 21300000, guid: 5129e7ee93f8186c6931623512dcc0b8, type: 3}
  maxAffectionLevel: 10
  affectionQuotes:
  - "\u041F\u0440\u0438\u0432\u0435\u0442-\u043F\u0440\u0438\u0432\u0435\u0442! \u042D\u043A\u0441\u043F\u0440\u0435\u0441\u0441-\u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430! \u041E\u0439, \u0430 \u0443 \u0432\u0430\u0441 \u0442\u0443\u0442 \u0442\u0430\u043A \u0432\u043A\u0443\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442, \u043C\u043E\u0436\u043D\u043E \u043C\u043D\u0435 \u0441\u0430\u043C\u044B\u0439 \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u043A\u043E\u0444\u0435 \u0441 \u0441\u043E\u0431\u043E\u0439?"
  - "\u0422\u0432\u043E\u0439 \u043A\u043E\u0444\u0435 \u0431\u043E\u0434\u0440\u0438\u0442 \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u043A\u0430! \u042F \u0441 \u043D\u0438\u043C \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434 \u0437\u0430 \u043D\u043E\u0447\u044C \u043E\u0431\u043B\u0435\u0442\u0430\u044E. \u041F\u0440\u044F\u043C\u043E \u0442\u0443\u0440\u0431\u043E-\u0440\u0435\u0436\u0438\u043C!"
  - "\u0421\u043B\u044B\u0448\u0430\u043B\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0441\u043F\u043B\u0435\u0442\u043D\u0438? \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u0432\u043E\u044F \u043A\u043E\u0444\u0435\u0439\u043D\u044F \u2014 \u043B\u0443\u0447\u0448\u0435\u0435 \u043C\u0435\u0441\u0442\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u0418 \u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E, \u043A\u0430\u043A \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043A\u0443\u0440\u044C\u0435\u0440!"
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0441\u044C, \u043D\u043E \u0442\u0443\u0442... \u043A\u0430\u043A-\u0442\u043E \u0442\u0435\u043F\u043B\u043E. \u0414\u0430\u0436\u0435 \u0440\u0430\u0446\u0438\u044F \u043C\u043E\u043B\u0447\u0438\u0442, \u0431\u0443\u0434\u0442\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
  - "\u042F \u043E\u0431\u044A\u0435\u0437\u0434\u0438\u043B\u0430 \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434, \u043D\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u044E\u0434\u0430 \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u043D\u044E \u043D\u0430 \u0432\u0441\u0435\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0443\u0442 \u043C\u0435\u043D\u044F \u0436\u0434\u0443\u0442. \u0422\u044B \u2014 \u043C\u043E\u0439 \u0441\u0430\u043C\u044B\u0439 \u0432\u0430\u0436\u043D\u044B\u0439 \u0430\u0434\u0440\u0435\u0441\u0430\u0442!"
  passiveStat: 5
  basePassiveValue: 0.25
  activeStat: 0
  baseActiveValue: 0.45
  abilityDescription: "\u0421\u0432\u044F\u0437\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435: \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438 \xAB\u0421\u0430\u0440\u0430\u0444\u0430\u043D\u043D\u043E\u0433\u043E \u0440\u0430\u0434\u0438\u043E\xBB."
