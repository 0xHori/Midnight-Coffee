  maxAffectionLevel: 10
  affectionQuotes:
  - "\u041F\u0440\u0438\u0432\u0435\u0442-\u043F\u0440\u0438\u0432\u0435\u0442! \u0413\u043E\u0442\u043E\u0432 \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0440\u0438\u0442\u043C? \u041A\u0430\u0436\u0434\u044B\u0439 \u0442\u0432\u043E\u0439 \u0442\u0430\u043F \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u043D\u043E\u0432\u0430\u044F \u043D\u043E\u0442\u0430!"
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0431\u0438\u0442! \u0415\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u2014 \u0438 \u043C\u044B \u0443\u0441\u0442\u0440\u043E\u0438\u043C \u0441\u0430\u043C\u044B\u0439 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043A\u043E\u043D\u0446\u0435\u0440\u0442 \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u044D\u043A\u0440\u0430\u043D\u0435!"
  - "\u041E\u0433\u043E, \u0434\u0430 \u0443 \u0442\u0435\u0431\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0442\u0435\u043C\u043F\u0430! \u0421 \u0442\u043E\u0431\u043E\u0439 \u043B\u044E\u0431\u0430\u044F \u043C\u0435\u043B\u043E\u0434\u0438\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0445\u0438\u0442\u043E\u043C."
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u0435\u0442\u044C \u0438\u043C\u0435\u043D\u043D\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F. \u0422\u0432\u043E\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u0438\u043D\u0442\u0435\u0437\u0430\u0442\u043E\u0440\u0430!"
  - "\u041D\u0430\u0448 \u0434\u0443\u044D\u0442 \u043D\u0435\u043F\u043E\u0431\u0435\u0434\u0438\u043C! \u041F\u043E\u043A\u0430 \u0442\u044B \u043A\u043B\u0438\u043A\u0430\u0435\u0448\u044C, \u044D\u0442\u0430 \u0441\u0446\u0435\u043D\u0430 \u0438 \u044D\u0442\u0430 \u043F\u0435\u0441\u043D\u044F \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u043C \u0434\u0432\u043E\u0438\u043C!"
  passiveStat: 0
  basePassiveValue: 0.05
  activeStat: 0
  baseActiveValue: 0.15
  abilityDescription: "\u0422\u0440\u0443\u0434\u043E\u043B\u044E\u0431\u0438\u0432\u0430\u044F \u043E\u0444\u0438\u0446\u0438\u0430\u043D\u0442\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0430 \u043F\u043E\u043C\u043E\u0447\u044C \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438."
