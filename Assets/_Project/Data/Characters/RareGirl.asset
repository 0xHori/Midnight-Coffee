    sprite: {fileID: -7038065751933149095, guid: 700107236c94bb30486d490a08864b2a, type: 3}
  maxAffectionLevel: 10
  affectionQuotes:
  - "\u041D\u0435 \u0442\u044B\u043A\u0430\u0439 \u0442\u0430\u043A \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E. \u0420\u0430\u043C \u0442\u0440\u0430\u0442\u0438\u0442 \u043D\u0430 \u0442\u0435\u0431\u044F \u0441\u0432\u043E\u0451 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u0443\u0434\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D."
  - "\u0425\u043C, \u0442\u0432\u043E\u0439 \u0442\u0435\u043C\u043F \u0441\u0442\u0430\u043B \u0447\u0443\u0442\u044C \u043B\u0443\u0447\u0448\u0435. \u0414\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u0430 \u0432\u043F\u043E\u043B\u043D\u0435 \u0441\u043D\u043E\u0441\u043D\u043E."
  - "\u0415\u0441\u043B\u0438 \u0431\u0443\u0434\u0435\u0448\u044C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0432 \u0442\u043E\u043C \u0436\u0435 \u0434\u0443\u0445\u0435, \u0442\u0430\u043A \u0443\u0436 \u0438 \u0431\u044B\u0442\u044C \u2014 \u0420\u0430\u043C \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0442\u0435\u0431\u0435 \u0443\u0433\u043E\u0441\u0442\u0438\u0442\u044C \u0435\u0451 \u043F\u0430\u0440\u0435\u043D\u044B\u043C \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C."
  - "\u041D\u0435 \u0437\u0430\u0437\u043D\u0430\u0432\u0430\u0439\u0441\u044F... \u043D\u043E \u043C\u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0432\u0440\u0435\u043C\u044F."
  - "\u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u044B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439, \u043A\u043E\u043C\u0443 \u0420\u0430\u043C \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439!"
  passiveStat: 1
  basePassiveValue: 0.1
  activeStat: 1
  baseActiveValue: 0.35
  abilityDescription: "\u041E\u043F\u044B\u0442\u043D\u0430\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F \u0441\u043C\u0435\u043D\u043E\u0439 \u2014 \u043F\u043E\u0434 \u0435\u0451 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 \u043A\u0430\u0444\u0435 \u043A\u0438\u043F\u0438\u0442 \u0432\u0434\u0432\u043E\u0435 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
