  characterId: rare_girl_2
  characterName: "\u0420\u0438\u043D\u0430 (\u0423\u043B\u0438\u0447\u043D\u044B\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444)"
  portrait: {fileID: 21300000, guid: cef96094b0b09d5eabc0163fd7f5e673, type: 3}
  rarity: 2
  emotions:
  - emotion: 0
    sprite: {fileID: 21300000, guid: 38f5aea4684864768845dbc95d56d69d, type: 3}
  - emotion: 1
    sprite: {fileID: 21300000, guid: c3f2361c221e25294befd34eb6c6cc65, type: 3}
  - emotion: 2
    sprite: {fileID: 21300000, guid: 143be0e8358005b839d81908ed60b05b, type: 3}
  - emotion: 3
    sprite: {fileID: 21300000, guid: 58f346e4a84bd7543a45c894ab69c54a, type: 3}
  maxAffectionLevel: 10
  affectionQuotes:
  - "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0441\u0432\u0435\u0442 \u043F\u043E \u043D\u043E\u0447\u0430\u043C. \u0412\u044B \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432, \u0435\u0441\u043B\u0438 \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u043F\u0430\u0440\u0443 \u0441\u043D\u0438\u043C\u043A\u043E\u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u0430?"
  - "\u0422\u0432\u043E\u044F \u043A\u043E\u0444\u0435\u0439\u043D\u044F \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u0433\u043E\u0442\u043E\u0432\u044B\u0439 \u043A\u0430\u0434\u0440 \u0434\u043B\u044F \u043E\u0431\u043B\u043E\u0436\u043A\u0438 \u0432\u0438\u043D\u0438\u043B\u0430. \u0422\u0435\u043F\u043B\u044B\u0439 \u0441\u0432\u0435\u0442, \u043F\u0430\u0440 \u043E\u0442 \u0447\u0430\u0448\u043A\u0438... \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u044D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u044F."
  - "\u0421\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A \u043D\u0435\u043E\u043D \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0443\u0436\u0435 \u0437\u0430 \u043E\u043A\u043D\u043E\u043C. \u0410 \u0442\u0432\u043E\u044F \u0443\u043B\u044B\u0431\u043A\u0430, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0432\u0437\u0431\u0438\u0432\u0430\u0435\u0448\u044C \u043C\u043E\u043B\u043E\u043A\u043E \u2014 \u043B\u0443\u0447\u0448\u0438\u0439 \u043A\u0430\u0434\u0440 \u0437\u0430 \u0432\u0441\u044E \u043C\u043E\u044E \u0441\u043C\u0435\u043D\u0443."
  - "\u042F \u043E\u0431\u044B\u0447\u043D\u043E \u043B\u043E\u0432\u043B\u044E \u043C\u043E\u043C\u0435\u043D\u0442\u044B, \u043D\u043E \u0441 \u0442\u043E\u0431\u043E\u0439 \u0432\u0440\u0435\u043C\u044F \u0431\u0443\u0434\u0442\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F. \u041C\u043E\u0436\u043D\u043E \u044F \u043F\u043E\u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0434\u043E\u043B\u044C\u0448\u0435, \u043F\u043E\u043A\u0430 \u043F\u043B\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F?"
  - "\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u0442\u044C \u0442\u0432\u043E\u044E \u0443\u043B\u044B\u0431\u043A\u0443. \u041D\u0435 \u0434\u043B\u044F \u0433\u043E\u0440\u043E\u0434\u0430, \u0430 \u0434\u043B\u044F \u0441\u0435\u0431\u044F. \u041C\u043E\u0436\u043D\u043E? \u041E\u0431\u0435\u0449\u0430\u044E, \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043C\u043E\u0439 \u0441\u0430\u043C\u044B\u0439 \u0443\u0434\u0430\u0447\u043D\u044B\u0439 \u043A\u0430\u0434\u0440."
  passiveStat: 2
  basePassiveValue: 0.03
  activeStat: 2
  baseActiveValue: 0.15
  abilityDescription: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0430\u0434\u0440: \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0448\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u043B\u0438\u043A\u0430 \u043D\u0430 15%."
