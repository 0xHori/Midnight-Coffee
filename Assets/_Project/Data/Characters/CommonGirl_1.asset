  characterId: common_girl_1
  characterName: "\u0410\u043D\u044F (\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430)"
  portrait: {fileID: 21300000, guid: 162b11d9652042dbd981d92d0de909f5, type: 3}
  rarity: 1
  emotions:
  - emotion: 0
    sprite: {fileID: 21300000, guid: 9fda20f4df029a2d5839ac8e216f7733, type: 3}
  - emotion: 1
    sprite: {fileID: 21300000, guid: 0e8f0496df39572fd826d9e4a6ac6d2c, type: 3}
  - emotion: 2
    sprite: {fileID: 21300000, guid: 82daf3ca9292b82ffb6b5a75bb3a4532, type: 3}
  - emotion: 3
    sprite: {fileID: 21300000, guid: 41c13527611ba39d084f053aa62df952, type: 3}
  maxAffectionLevel: 10
  affectionQuotes:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u041C\u043E\u0436\u043D\u043E \u043C\u043D\u0435 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u043E? \u041D\u043E\u0447\u044C \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u043E\u043B\u0433\u043E\u0439, \u0430 \u044D\u0441\u043A\u0438\u0437\u044B \u0441\u0430\u043C\u0438 \u0441\u0435\u0431\u044F \u043D\u0435 \u043D\u0430\u0440\u0438\u0441\u0443\u044E\u0442."
  - "\u041E\u0431\u043E\u0436\u0430\u044E, \u043A\u0430\u043A \u0432 \u0442\u0432\u043E\u0435\u0439 \u043A\u043E\u0444\u0435\u0439\u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0432\u0435\u0436\u0435\u0439 \u043E\u0431\u0436\u0430\u0440\u043A\u043E\u0439 \u0438 \u0434\u043E\u0436\u0434\u0451\u043C \u0437\u0430 \u043E\u043A\u043D\u043E\u043C. \u0421\u0440\u0430\u0437\u0443 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435!"
  - "\u0422\u0432\u043E\u0439 \u043B\u0430\u0442\u0442\u0435-\u0430\u0440\u0442 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430! \u0414\u0430\u0436\u0435 \u0436\u0430\u043B\u043A\u043E \u0440\u0430\u0437\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C \u0442\u0430\u043A\u0443\u044E \u043A\u0440\u0430\u0441\u043E\u0442\u0443."
  - "\u041A\u043E\u0433\u0434\u0430 \u0441\u0438\u0436\u0443 \u0437\u0430 \u044D\u0442\u0438\u043C \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u043C \u0432 \u0443\u0433\u043B\u0443, \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u044B \u0443\u0436\u0435 \u043D\u0435 \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u043C\u0438. \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0443\u044E\u0442!"
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u0442\u0432\u043E\u044F \u043A\u043E\u0444\u0435\u0439\u043D\u044F \u0441\u0442\u0430\u043B\u0430 \u043C\u043E\u0438\u043C \u043B\u044E\u0431\u0438\u043C\u044B\u043C \u043C\u0435\u0441\u0442\u043E\u043C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u0433\u043B\u044F\u043D\u0443 \u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u043E\u0447\u044C\u044E!"
  passiveStat: 1
  basePassiveValue: 0.05
  activeStat: 0
  baseActiveValue: 0.15
  abilityDescription: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430-\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u0430: \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u043E \u043F\u0435\u0440\u0435\u0434 \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u0430\u043C\u0438 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0441 \u0437\u0430\u043A\u0430\u0437\u0430\u043C\u0438."
