  characterId: common_girl_2
  characterName: "\u041D\u0438\u043A\u0430 (\u0421\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442)"
  portrait: {fileID: 21300000, guid: 85351752907ec4879b9a3149dea4c19d, type: 3}
  rarity: 1
  emotions:
  - emotion: 0
    sprite: {fileID: 21300000, guid: 5092856786cf339669ec460655ba41b5, type: 3}
  - emotion: 1
    sprite: {fileID: 21300000, guid: 331b3bce170c59a1b8da3cc550be372a, type: 3}
  - emotion: 2
    sprite: {fileID: 21300000, guid: 15ce833df082a17629c76f62ac090eb1, type: 3}
  - emotion: 3
    sprite: {fileID: 21300000, guid: 38daeaf0926a249bfbd47cc2daeeeb33, type: 3}
  maxAffectionLevel: 10
  affectionQuotes:
  - "\u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u044D\u0441\u043F\u0440\u0435\u0441\u0441\u043E, \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430. \u0418, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0439 \u0441\u043E \u043C\u043D\u043E\u0439, \u043F\u043E\u043A\u0430 \u044F \u043D\u0435 \u043F\u043E\u0444\u0438\u043A\u0448\u0443 \u044D\u0442\u043E\u0442 \u0431\u0430\u0433."
  - "\u0422\u0443\u0442 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 Wi-Fi. \u0418 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043A\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u044F \u043F\u044C\u044E \u0442\u0440\u0435\u0442\u044C\u044E \u0431\u0430\u043D\u043A\u0443 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u043A\u0430 \u0437\u0430 \u043D\u043E\u0447\u044C. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0431\u044D\u043A\u0435\u043D\u0434 \u0434\u043B\u044F \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0435\u0441\u0441\u0438\u0438."
  - "\u0422\u0432\u043E\u0439 \u043B\u0430\u0442\u0442\u0435-\u0430\u0440\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C \u043C\u043E\u0439 \u043A\u043E\u0434 \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u043F\u043B\u043E\u044F \u0432 \u043F\u044F\u0442\u043D\u0438\u0446\u0443 \u0432\u0435\u0447\u0435\u0440\u043E\u043C. \u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u0443\u0434\u0430\u0435\u0442\u0441\u044F?"
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u043E\u0431\u044B\u0447\u043D\u043E \u044F \u0438\u0437\u0431\u0435\u0433\u0430\u044E \u043B\u044E\u0434\u0435\u0439, \u043D\u043E \u0442\u0443\u0442... \u043A\u0430\u043A-\u0442\u043E \u0443\u044E\u0442\u043D\u043E. \u0414\u0430\u0436\u0435 \u0431\u0430\u0433\u0438 \u043D\u0435 \u0442\u0430\u043A \u0431\u0435\u0441\u044F\u0442, \u043A\u043E\u0433\u0434\u0430 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0432\u0435\u0436\u0435\u0439 \u043E\u0431\u0436\u0430\u0440\u043A\u043E\u0439."
  - "\u0422\u0432\u043E\u0439 \u043A\u043E\u0444\u0435 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0441\u0435\u0440\u0432\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u0430\u0434\u0430\u0435\u0442. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0442\u044B \u0435\u0441\u0442\u044C. \u041F\u043E\u0439\u0434\u0443, \u0437\u0430\u043A\u043E\u043C\u043C\u0438\u0447\u0443 \u0441\u0432\u043E\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430... \u0432 \u0441\u043C\u044B\u0441\u043B\u0435, \u043A\u043E\u0434."
  passiveStat: 0
  basePassiveValue: 0.05
  activeStat: 1
  baseActiveValue: 0.18
  abilityDescription: "\u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F \u043A\u043E\u0434\u0430: \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u043D\u0430 5-10%."
